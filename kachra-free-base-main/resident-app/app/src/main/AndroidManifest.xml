<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Used only for the one-time "use my current location" button during
         registration - the resident is never tracked continuously. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- usesCleartextTraffic: allows plain http:// while the server has no https setup yet; remove once the server uses https -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KachraFreeResident"
        android:windowSoftInputMode="adjustResize"
        android:usesCleartextTraffic="true">

        <!-- This is the ONLY third-party key this app embeds, and it has to
             be: the Maps SDK for Android renders map tiles on-device and
             calls Google's servers directly, so the key must exist in the
             installed app. It is not a secret - restrict it in Google Cloud
             Console (Android app restriction: this package name + your
             signing certificate's SHA-1, plus API restriction: Maps SDK for
             Android only) so it's useless to anyone outside this exact
             signed app. Comes from local.properties via manifestPlaceholders
             - never hardcoded here. See docs/PROTOCOL.md "API key handling".
             Location SEARCH does not need a client key - see PlacesApi.kt,
             which calls the server instead, where that key belongs. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${mapsApiKey}" />

        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <activity
            android:name=".LocationPickerActivity"
            android:exported="false" />

    </application>

</manifest>
